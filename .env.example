# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit the real key. Put it in .env.local, which git ignores.
GEMINI_API_KEY=

# Vision-capable Flash model id. Docs: https://ai.google.dev/gemini-api/docs/models
# Paste the current name here, for example gemini-3.8-flash. The app does not hard-code it.
GEMINI_MODEL=
