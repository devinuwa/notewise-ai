# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit the real key. Put it in .env.local, which git ignores.
GEMINI_API_KEY=

# Vision-capable Flash-Lite model id. Docs: https://ai.google.dev/gemini-api/docs/models
# Paste the current fastest Flash or Flash-Lite name here. The app does not hard-code it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Identity Services OAuth client (Web application). Browser only. Drive backup uses drive.file.
# See the README section "Google Drive setup". No client secret in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public site origin for Open Graph, sitemap, and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://notewise-ai-lovat.vercel.app

